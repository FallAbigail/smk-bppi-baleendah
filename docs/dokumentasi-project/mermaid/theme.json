{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Calibri, Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#f5f5f5",
    "primaryTextColor": "#111111",
    "primaryBorderColor": "#333333",
    "lineColor": "#333333",
    "secondaryColor": "#eeeeee",
    "tertiaryColor": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 28,
    "rankSpacing": 24,
    "padding": 10,
    "wrappingWidth": 230
  },
  "securityLevel": "strict",
  "look": "classic",
  "sequence": {
    "width": 90,
    "actorMargin": 35,
    "actorFontSize": 24,
    "messageFontSize": 24,
    "noteFontSize": 24,
    "mirrorActors": false,
    "messageMargin": 32,
    "diagramMarginX": 10
  }
}